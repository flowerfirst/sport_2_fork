<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 1. MAIN BRAND COLORS -->
    <!-- Deep Navy Blue -->
    <Color x:Key="Primary">#1A237E</Color>
    <Color x:Key="PrimaryDark">#000051</Color>

    <!-- Lighter Blue for gradients/highlights -->
    <Color x:Key="PrimaryLight">#3949AB</Color>

    <!-- 2. ACCENT COLORS -->
    <!-- Soft Amber/Gold for crucial buttons (Book Now, Login) to make them pop -->
    <Color x:Key="Accent">#FFC107</Color>
    <Color x:Key="AccentDark">#FF8F00</Color>
    <Color x:Key="Secondary">#E3F2FD</Color>

    <!-- 3. BACKGROUNDS -->
    <Color x:Key="PageBackgroundLight">#F5F6FA</Color>
    <!-- Very light blue-grey -->
    <Color x:Key="PageBackgroundDark">#121212</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- 4. TEXT COLORS -->
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="PrimaryText">#1A1A1A</Color>
    <Color x:Key="SecondaryText">#757575</Color>
    <Color x:Key="WhiteText">#FFFFFF</Color>

    <!-- 5. STATES -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray900">#212121</Color>

</ResourceDictionary>